	-$(RM) $(OBJS_AS_ARGS) $(EXECUTABLES)  
	-$(RM) $(C_DEPS_AS_ARGS)   
	rm -rf "Graduation-Project.elf" "Graduation-Project.a" "Graduation-Project.hex" "Graduation-Project.lss" "Graduation-Project.eep" "Graduation-Project.map" "Graduation-Project.srec" "Graduation-Project.usersignatures"
	